# experiment.sh environment configuration
# Copy this file to scripts/.env and fill in your values.
# scripts/.env is gitignored and will not be committed.

# ── Relay host (required) ──────────────────────────────────────────────────────
# SSH target for the relay machine (always remote).
RELAY_SSH="user@relay-host-ip"

# Absolute path to the moqtail project on the relay host.
RELAY_PROJECT="/home/user/projects/moqtail/moqtail"

# QUIC port the relay listens on (default: 4433).
# RELAY_PORT=4433

# ── Publisher host (optional) ──────────────────────────────────────────────────
# Leave PUB_SSH empty to run the publisher locally (same machine as subscriber).
# Set it to an SSH target if the publisher runs on a separate remote machine.
PUB_SSH=""

# Absolute path to the moqtail project on the publisher host.
# Only needed when PUB_SSH is set.
# PUB_PROJECT="/home/user/projects/moqtail/moqtail"

# ── MOQ namespace ──────────────────────────────────────────────────────────────
# Must match the namespace published by moqtail-pub (default below).
# NAMESPACE="moqtail-watch-party-live"
